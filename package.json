{
  "name": "sih26125",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "demo:reset": "pnpm --filter @sih26125/contracts deploy:local && pnpm --filter @sih26125/chain seed",
    "e2e": "pnpm demo:reset && pnpm --filter @sih26125/web e2e"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.19.0"
}
