# Copy to .env and fill in. docker compose reads this file automatically.
#
#   cp .env.example .env
#
# .env is git-ignored. Nothing here should ever reach a commit.

# Signs the session cookie. session.ts refuses to start in production without it.
#   openssl rand -hex 32
AUTH_SECRET=

# The Postgres this stack creates. Personal data lives here and never on chain,
# so this password is protecting the DPDP boundary, not just a cache.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sih26125

# The chain. Inside compose this is the first Besu validator by container name;
# from the host it would be http://127.0.0.1:8545.
RPC_URL=http://besu-node-1:8545

# Which deployments/<name>.json holds the contract addresses.
DEPLOYMENT_NETWORK=besu

# Where the console is published on the host.
WEB_PORT=3000

# How often the indexer polls for new blocks, in milliseconds.
POLL_MS=4000

# --- Demo only -------------------------------------------------------------
# The HD seed the server derives every persona's key from. It exists so a stage
# demo has no wallet popups, and it has no production counterpart: a deployment
# has no seed from which the server can sign as anybody. See docs/PRODUCTION.md.
# DEMO_MNEMONIC=
